    <script>
      import { stacks } from "../lib/stacks";
      import { mountChrome } from "../lib/chrome";

      mountChrome();

      const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;

      // The stack picker. The page renders every stack's code; CSS shows the
      // one named by <html data-stack>, which the head script sets on load.
      const root = document.documentElement;
      const hint = document.querySelector<HTMLElement>("[data-stack-hint]");
      const docsTabs = Object.fromEntries(stacks.map((st) => [st.id, st.docsTab]));
      const showStack = (id: string) => {
        const radio = document.querySelector<HTMLInputElement>(`input[name="stack"][value="${id}"]`);
        if (radio) radio.checked = true;
        if (hint) hint.textContent = "Code on this page and in the docs follows your pick.";
      };
      if (root.dataset.stack) showStack(root.dataset.stack);
      for (const radio of document.querySelectorAll<HTMLInputElement>('input[name="stack"]')) {
        radio.addEventListener("change", () => {
          root.dataset.stack = radio.value;
          showStack(radio.value);
          try {
            localStorage.setItem("glimmer-stack", radio.value);
            // Docs pages open their framework tabs on the matching one.
            const tab = docsTabs[radio.value];
            if (tab) localStorage.setItem("starlight-synced-tabs__framework", tab);
          } catch {}
        });
      }

      // Copy buttons copy the command that's showing.
      for (const button of document.querySelectorAll<HTMLButtonElement>(".mk-copy")) {
        button.addEventListener("click", async () => {
          const codes = [...(button.parentElement?.querySelectorAll("code") ?? [])];
          const shown = codes.find((code) => code.getClientRects().length > 0);
          try {
            await navigator.clipboard.writeText(shown?.textContent ?? "");
            button.textContent = "Copied";
          } catch {
            button.textContent = "Press Ctrl+C";
          }
          setTimeout(() => (button.textContent = "Copy"), 1600);
        });
      }

      // Mark the component whose panel is in the middle of the screen.
      const links = [...document.querySelectorAll<HTMLAnchorElement>("[data-spy]")];
      const spy = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            const id = (entry.target as HTMLElement).dataset.panel;
            for (const link of links) {
              if (link.dataset.spy === id) link.setAttribute("aria-current", "true");
              else link.removeAttribute("aria-current");
            }
          }
        },
        { rootMargin: "-45% 0px -50% 0px" }
      );
      document.querySelectorAll("[data-panel]").forEach((panel) => spy.observe(panel));

      // Count numbers up from zero the first time they scroll into view.
      const counters = new IntersectionObserver((entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          counters.unobserve(entry.target);
          const el = entry.target as HTMLElement;
          const target = Number(el.dataset.count);
          if (reduceMotion || !target) continue;
          const start = performance.now();
          const tick = (now: number) => {
            const t = Math.min(1, (now - start) / 900);
            el.textContent = String(Math.round(target * (1 - Math.pow(1 - t, 3))));
            if (t < 1) requestAnimationFrame(tick);
          };
          el.textContent = "0";
          requestAnimationFrame(tick);
        }
      });
      document.querySelectorAll("[data-count]").forEach((el) => counters.observe(el));

      // Live count of the effects on this page.
      const count = document.querySelector("[data-effect-count]");
      const update = () => {
        const n = String(document.querySelectorAll("[data-glimmer]").length);
        // Writing the text is itself a mutation, so only write when it changes.
        if (count && count.textContent !== n) count.textContent = n;
      };
      new MutationObserver(update).observe(document.body, { childList: true, subtree: true });
      update();
    </script>
