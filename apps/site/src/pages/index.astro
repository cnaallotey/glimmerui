---
import "@fontsource-variable/geist";
import "@fontsource-variable/geist-mono";
import "../styles/tokens.css";
import "../styles/marketing.css";
import { Code } from "astro:components";
import {
  AsciiImage,
  Aurora,
  BorderBeam,
  Caustics,
  ContourLines,
  DitherImage,
  DotGrid,
  DuotoneImage,
  FogImage,
  GlitchImage,
  GridFloor,
  HalftoneImage,
  HoloCard,
  ImageDistortion,
  ImageReveal,
  InkSmoke,
  KaleidoscopeImage,
  LensImage,
  LightRays,
  LiquidMetal,
  MeshGradient,
  Particles,
  PixelImage,
  Plasma,
  RainImage,
  RippleImage,
  ScrollImage,
  ShaderButton,
  ShaderGradient,
  ShaderText,
  Silk,
  SpotlightCard,
  Starfield,
  TiltCard,
  Voronoi,
} from "@glimmerui/react";
import { SwatchGrid } from "../components/marketing/SwatchGrid";
import PanelCaption from "../components/marketing/PanelCaption.astro";
import { TransitionPanel } from "../components/marketing/TransitionPanel";
import { TrailToggle } from "../components/marketing/TrailToggle";
import logo from "../assets/logo.svg?raw";
import { nightTheme } from "../styles/code-theme";
import { withBase } from "../lib/url";
import { stackLogo, stacks } from "../lib/stacks";
import { OG_HEIGHT, OG_WIDTH, ogImageUrl } from "../lib/og";

const title = "Glimmer UI: WebGL shader components for React, Vue, Nuxt and Svelte";
const description =
  "37 WebGL components for React, Vue, Nuxt and Svelte: shader backgrounds, image and video effects, scroll transitions. CSS fallbacks and reduced motion built in.";
const canonical = new URL(withBase("/"), Astro.site).href;
const image = ogImageUrl("index", Astro.site);
// Structured data, so search engines know this is a code library.
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareSourceCode",
  name: "Glimmer UI",
  description,
  url: canonical,
  image,
  codeRepository: "https://github.com/cnaallotey/glimmerui",
  programmingLanguage: ["TypeScript", "GLSL"],
  runtimePlatform: ["React", "Vue", "Nuxt", "Svelte"],
  license: "https://opensource.org/licenses/MIT",
};

// Small line icons, drawn on a 20px grid in the current text color.
const icon = {
  spark: `<path d="M10 2.5v4M10 13.5v4M2.5 10h4M13.5 10h4M5 5l2.5 2.5M12.5 12.5 15 15M15 5l-2.5 2.5M7.5 12.5 5 15"/>`,
  gradient: `<circle cx="10" cy="10" r="7"/><path d="M10 3a7 7 0 0 0 0 14"/>`,
  ripple: `<circle cx="10" cy="10" r="2"/><path d="M5.5 10a4.5 4.5 0 0 1 9 0M3 10a7 7 0 0 1 14 0"/>`,
  tilt: `<path d="M4 6.5 14 4v12L4 13.5z"/>`,
  reveal: `<rect x="3" y="3" width="14" height="14" rx="2"/><path d="M3 13c3-1 5-4 7-10"/>`,
  lens: `<circle cx="9" cy="9" r="5.5"/><path d="m13 13 4 4M7 7.2a2.5 2.5 0 0 1 2-1"/>`,
  aurora: `<path d="M2.5 13c2-3 4-3 6 0s4 3 6 0 2.5-2 3-2M2.5 8.5c2-3 4-3 6 0s4 3 6 0"/>`,
  dots: `<circle cx="6" cy="6" r="1"/><circle cx="14" cy="6" r="1"/><circle cx="6" cy="14" r="1"/><circle cx="14" cy="14" r="1"/><circle cx="10" cy="10" r="2"/>`,
  context: `<rect x="3" y="3" width="14" height="14" rx="2"/><path d="M3 8h14M8 8v9"/>`,
  fallback: `<path d="M4 10h12M10 4v12"/><rect x="3" y="3" width="14" height="14" rx="2"/>`,
  pause: `<path d="M8 6v8M12 6v8"/><circle cx="10" cy="10" r="7"/>`,
  motion: `<path d="M3 10h4l2-4 2 8 2-4h4"/>`,
  update: `<path d="M15.5 8A6 6 0 0 0 4.6 6.5M4.5 12a6 6 0 0 0 10.9 1.5M15.5 4v4h-4M4.5 16v-4h4"/>`,
  server: `<rect x="3" y="4" width="14" height="5" rx="1.5"/><rect x="3" y="11" width="14" height="5" rx="1.5"/><path d="M6 6.5h.01M6 13.5h.01"/>`,
  liquid: `<path d="M6 13.5a3.5 3.5 0 1 1 3.2-5 3 3 0 1 1 3.3 4.3A3.5 3.5 0 0 1 6 13.5z"/>`,
  particles: `<circle cx="5" cy="6" r=".8"/><circle cx="14" cy="4.5" r=".8"/><circle cx="9" cy="10" r="1.3"/><circle cx="15" cy="13" r=".8"/><circle cx="5.5" cy="15" r=".8"/><circle cx="11.5" cy="16" r=".8"/>`,
  halftone: `<circle cx="5" cy="5" r="2"/><circle cx="11" cy="5" r="1.3"/><circle cx="16" cy="5" r=".6"/><circle cx="5" cy="11" r="1.3"/><circle cx="11" cy="11" r=".7"/><circle cx="5" cy="16" r=".6"/>`,
  pixel: `<rect x="3" y="3" width="6" height="6"/><rect x="11" y="3" width="6" height="6"/><rect x="3" y="11" width="6" height="6"/><rect x="11" y="11" width="3" height="3"/><rect x="14" y="14" width="3" height="3"/>`,
  mesh: `<rect x="3" y="3" width="14" height="14" rx="3"/><path d="M3 10c4-3 10 3 14 0M10 3c-3 4 3 10 0 14"/>`,
  silk: `<path d="M3 6c3-2 5 2 8 0s4-2 6 0M3 10.5c3-2 5 2 8 0s4-2 6 0M3 15c3-2 5 2 8 0s4-2 6 0"/>`,
  caustics: `<path d="M4 5l4 3-1 5 5 2 4-4M8 8l5-3M7 13l-3 2M12 15l1 2"/>`,
  contours: `<path d="M10 4c4 0 6 3 6 6s-3 6-6 6-6-2-6-6 2-6 6-6z"/><path d="M10 7.5c2 0 3 1.2 3 2.5s-1.3 2.5-3 2.5-3-1-3-2.5 1-2.5 3-2.5z"/>`,
  stars: `<path d="M10 3v3M10 14v3M3 10h3M14 10h3"/><circle cx="10" cy="10" r="1"/><path d="M5 5l1.5 1.5M13.5 13.5 15 15"/>`,
  voronoi: `<path d="M3 8l5-1 3 4-2 6M8 7l2-4M11 11l6-2M9 17l-6-3"/><rect x="3" y="3" width="14" height="14" rx="2"/>`,
  grid: `<path d="M2.5 16h15M5 12h10M7 9h6M10 9v7M7 9l-3 7M13 9l3 7"/><path d="M4 6h12"/>`,
  smoke: `<path d="M10 17c0-3 3-4 3-7s-3-3-3-5M7 17c0-2 2-3 2-5"/>`,
  glitch: `<rect x="3" y="4" width="14" height="3"/><rect x="5" y="9" width="12" height="3"/><rect x="2" y="14" width="13" height="3"/>`,
  dither: `<path d="M4 4h2v2H4zM8 4h2v2H8zM12 4h2v2h-2zM6 8h2v2H6zM10 8h2v2h-2zM4 12h2v2H4zM8 12h2v2H8zM6 16h2v.01"/>`,
  ascii: `<path d="M4 6h3M9 6h2M13 6h3M4 10h5M11 10h5M4 14h2M8 14h4M14 14h2"/>`,
  duotone: `<circle cx="10" cy="10" r="7"/><path d="M10 3v14" /><path d="M10 3a7 7 0 0 1 0 14z" fill="currentColor" stroke="none"/>`,
  fog: `<path d="M3 7h10M6 10h11M3 13h9M8 16h7"/><circle cx="14" cy="6" r="1.5"/>`,
  kaleido: `<path d="M10 3v14M3 10h14M5 5l10 10M15 5 5 15"/><circle cx="10" cy="10" r="3"/>`,
  holo: `<rect x="4" y="3" width="12" height="14" rx="2"/><path d="M6 13l8-8M8 15l6-6"/>`,
  spotlight: `<rect x="3" y="4" width="14" height="12" rx="3"/><circle cx="13" cy="8" r="2"/>`,
  button: `<rect x="2.5" y="6" width="15" height="8" rx="4"/><path d="M7 10h6"/>`,
  text: `<path d="M4 5h12M10 5v11M7 16h6"/>`,
  trail: `<path d="M3 16c3-1 4-5 7-7s5-2 7-5"/><circle cx="17" cy="4" r="1.5"/>`,
  transition: `<rect x="3" y="5" width="9" height="10" rx="1.5"/><path d="M14.5 5.5A1.5 1.5 0 0 1 17 6.5v7a1.5 1.5 0 0 1-2.5 1"/><path d="m7 8 2 2-2 2"/>`,
  scroll: `<path d="M3 5c3 2.5 11 2.5 14 0M3 15c3 2.5 11 2.5 14 0M3 5v10M17 5v10M10 9.5v3M8.5 11l1.5 1.5 1.5-1.5"/>`,
  drops: `<circle cx="10" cy="10" r="1"/><circle cx="10" cy="10" r="4"/><circle cx="10" cy="10" r="7"/>`,
  rain: `<path d="M7 3.5c1.6 2.2 2.4 3.6 2.4 4.8a2.4 2.4 0 0 1-4.8 0C4.6 7.1 5.4 5.7 7 3.5zM14 9c1.3 1.8 2 3 2 4a2 2 0 0 1-4 0c0-1 .7-2.2 2-4z"/>`,
  rays: `<path d="M10 3v14M8 3 4.5 16M12 3l3.5 13M6 3 2.5 12M14 3l3.5 9"/>`,
  plasma: `<path d="M3 13c2-1 2-5 4-5s1 5 3.5 5 1.5-7 3.5-7 1.5 3 3 2.5"/>`,
  beam: `<rect x="3" y="4.5" width="14" height="11" rx="3"/><path d="M6 4.5h6" stroke-width="3"/>`,
  film: `<rect x="3" y="4.5" width="14" height="11" rx="2"/><path d="m8.5 7.5 4 2.5-4 2.5z"/>`,
  sliders: `<path d="M4 6h12M4 10h12M4 14h12"/><circle cx="7" cy="6" r="1.5"/><circle cx="13" cy="10" r="1.5"/><circle cx="9" cy="14" r="1.5"/>`,
  access: `<circle cx="10" cy="4.5" r="1.5"/><path d="M4 7.5 10 9l6-1.5M10 9v3.5M7 17l3-4.5 3 4.5"/>`,
};

const svg = (paths: string) =>
  `<svg viewBox="0 0 20 20" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${paths}</svg>`;

const components = [
  { id: "shader-gradient", name: "ShaderGradient", icon: icon.gradient, lead: "An animated gradient that bends around the pointer.", rest: "Any three colors, as a background with your content on top." },
  { id: "image-distortion", name: "ImageDistortion", icon: icon.ripple, lead: "Ripples spread out from the pointer.", rest: "The image's colors split as each ripple passes." },
  { id: "tilt-card", name: "TiltCard", icon: icon.tilt, lead: "A card that tilts in true perspective.", rest: "With a glare that follows the pointer and crisp rounded corners." },
  { id: "image-reveal", name: "ImageReveal", icon: icon.reveal, lead: "One image dissolves into another.", rest: "The edge spreads from wherever the pointer enters. A tap toggles it on touch screens." },
  { id: "lens-image", name: "LensImage", icon: icon.lens, lead: "A glass lens that follows the pointer.", rest: "It magnifies the image beneath, with color fringing toward the rim." },
  { id: "aurora", name: "Aurora", icon: icon.aurora, lead: "Curtains of light over a night sky.", rest: "They drift on their own, and the pointer pulls them toward it." },
  { id: "dot-grid", name: "DotGrid", icon: icon.dots, lead: "Dots that swell and part around the pointer.", rest: "Quiet enough to sit behind text and forms." },
  { id: "liquid-metal", name: "LiquidMetal", icon: icon.liquid, lead: "Chrome blobs that drift, merge and split.", rest: "Hovering adds one more that trails the pointer and melts into the rest." },
  { id: "particles", name: "Particles", icon: icon.particles, lead: "Thousands of points drifting across the page.", rest: "Near the pointer they gather into a turning swirl." },
  { id: "halftone-image", name: "HalftoneImage", icon: icon.halftone, lead: "An image printed as a halftone of dots.", rest: "Around the pointer the dots open into the full-color image." },
  { id: "pixel-image", name: "PixelImage", icon: icon.pixel, lead: "A coarse mosaic that sharpens as you look.", rest: "Blocks halve in size ring by ring toward the pointer." },
  { id: "mesh-gradient", name: "MeshGradient", icon: icon.mesh, lead: "Four colors blended across a warping surface.", rest: "Film grain keeps it from banding; the pointer drags it." },
  { id: "silk", name: "Silk", icon: icon.silk, lead: "Satin folds with a sheen along each crest.", rest: "The pointer pinches the fabric into a peak." },
  { id: "caustics", name: "Caustics", icon: icon.caustics, lead: "The web of light on the floor of a pool.", rest: "Hovering sends rings out through the pattern." },
  { id: "contour-lines", name: "ContourLines", icon: icon.contours, lead: "A topographic map that slowly shifts.", rest: "The pointer raises a hill the lines ring around." },
  { id: "starfield", name: "Starfield", icon: icon.stars, lead: "A flight through stars streaking past.", rest: "Hovering moves the vanishing point and speeds up." },
  { id: "voronoi", name: "Voronoi", icon: icon.voronoi, lead: "Stained glass of slowly drifting cells.", rest: "Cells near the pointer light up from behind." },
  { id: "grid-floor", name: "GridFloor", icon: icon.grid, lead: "A glowing grid rolling toward the horizon.", rest: "The pointer presses a dip into the floor." },
  { id: "ink-smoke", name: "InkSmoke", icon: icon.smoke, lead: "A plume of smoke rising and curling.", rest: "On hover it drifts after the pointer." },
  { id: "glitch-image", name: "GlitchImage", icon: icon.glitch, lead: "An image that glitches on hover.", rest: "Bands jump and colors split, strongest at the pointer." },
  { id: "dither-image", name: "DitherImage", icon: icon.dither, lead: "An image in one-bit dither.", rest: "Full color shows through around the pointer." },
  { id: "ascii-image", name: "AsciiImage", icon: icon.ascii, lead: "An image drawn in text characters.", rest: "The real image shows through around the pointer." },
  { id: "duotone-image", name: "DuotoneImage", icon: icon.duotone, lead: "A two-color print of an image.", rest: "On hover its real colors spread from the pointer." },
  { id: "fog-image", name: "FogImage", icon: icon.fog, lead: "An image behind frosted glass.", rest: "The pointer wipes a clear patch that follows it." },
  { id: "kaleidoscope-image", name: "KaleidoscopeImage", icon: icon.kaleido, lead: "An image folded into mirrored wedges.", rest: "The pointer turns and zooms the pattern." },
  { id: "holo-card", name: "HoloCard", icon: icon.holo, lead: "A tilt card with a holographic foil.", rest: "Rainbow bands and glints shift as it tilts." },
  { id: "spotlight-card", name: "SpotlightCard", icon: icon.spotlight, lead: "A card whose border lights up near you.", rest: "A soft spotlight follows the pointer across it." },
  { id: "shader-button", name: "ShaderButton", icon: icon.button, lead: "A button with a live color fill.", rest: "It brightens on hover and on keyboard focus." },
  { id: "shader-text", name: "ShaderText", icon: icon.text, lead: "Text filled with flowing color.", rest: "It stays real text: selectable and read aloud." },
  { id: "cursor-trail", name: "CursorTrail", icon: icon.trail, lead: "A glowing trail behind the cursor.", rest: "It fades and stops drawing when the mouse rests." },
  { id: "image-transition", name: "ImageTransition", icon: icon.transition, lead: "Shader transitions between images.", rest: "Five of them, driven by an index, the scroll or your own number." },
  { id: "scroll-image", name: "ScrollImage", icon: icon.scroll, lead: "An image that bends as the page scrolls.", rest: "The faster it goes, the more it bends and splits its colors." },
  { id: "ripple-image", name: "RippleImage", icon: icon.drops, lead: "An image under still water.", rest: "The pointer leaves a wake, and a click drops a stone." },
  { id: "rain-image", name: "RainImage", icon: icon.rain, lead: "An image behind a rainy window.", rest: "Drops bend the view, and the pointer wipes the glass dry." },
  { id: "light-rays", name: "LightRays", icon: icon.rays, lead: "Shafts of light from the top edge.", rest: "They drift on their own and lean toward the pointer." },
  { id: "plasma", name: "Plasma", icon: icon.plasma, lead: "Glowing strands of energy.", rest: "They flare, fade and bend toward the pointer." },
  { id: "border-beam", name: "BorderBeam", icon: icon.beam, lead: "A beam of light around a card's border.", rest: "It keeps its pace through the corners and speeds up on hover." },
];

const behaviours = [
  { icon: icon.fallback, title: "Falls back to CSS", text: "Without WebGL, gradients become CSS gradients and images stay visible." },
  { icon: icon.pause, title: "Pauses offscreen", text: "An effect stops drawing when it scrolls out of view." },
  { icon: icon.motion, title: "Respects reduced motion", text: "Effects hold a still frame and follow the pointer without animating." },
  { icon: icon.update, title: "Updates in place", text: "Changing a prop updates the running effect. Nothing is torn down or reloaded." },
  { icon: icon.server, title: "Works with server rendering", text: "", server: true },
  { icon: icon.access, title: "Accessible by default", text: "Image effects read as images, and canvases are hidden from screen readers." },
  { icon: icon.film, title: "Takes video too", text: "Every image effect plays a video, only while it's on screen." },
  { icon: icon.motion, title: "Follows the scroll", text: "Transitions run from the scroll position, with a prop or a hook." },
  { icon: icon.sliders, title: "Tuned in the docs", text: "Change any prop live, start from a preset, and copy the code." },
];

const footerLinks = [
  {
    title: "Docs",
    links: [
      ["Introduction", "/docs/"],
      ["Installation", "/docs/installation/"],
      ["React", "/docs/react/"],
      ["Vue", "/docs/vue/"],
      ["Nuxt", "/docs/nuxt/"],
      ["Svelte", "/docs/svelte/"],
    ],
  },
  {
    title: "Components",
    links: components.map((c) => [c.name, `/docs/components/${c.id}/`]),
  },
  {
    title: "Guides",
    links: [
      ["Accessibility", "/docs/guides/accessibility/"],
      ["Performance", "/docs/guides/performance/"],
      ["Server rendering", "/docs/guides/server-rendering/"],
      ["Scroll", "/docs/guides/scroll/"],
      ["Images and video", "/docs/guides/images/"],
      ["Core API", "/docs/guides/core-api/"],
    ],
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={withBase("/favicon.svg")} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={withBase("/apple-touch-icon.png")} />
    <link rel="sitemap" href={withBase("/sitemap-index.xml")} />
    <meta name="theme-color" content="#fafafa" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Glimmer UI" />
    <meta property="og:locale" content="en" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content={String(OG_WIDTH)} />
    <meta property="og:image:height" content={String(OG_HEIGHT)} />
    <meta property="og:image:alt" content="Glimmer UI: thirty-seven shader effects for React, Vue, Nuxt and Svelte" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script is:inline define:vars={{ ids: stacks.map((st) => st.id) }}>
      // Apply the visitor's stack before the first paint, so code never flickers.
      try {
        const saved = localStorage.getItem("glimmer-stack");
        if (ids.includes(saved)) document.documentElement.dataset.stack = saved;
      } catch {}
    </script>
  </head>
  <body class="mk">
    <a class="mk-skip" href="#main">Skip to content</a>

    <header class="mk-header">
      <div class="mk-wrap mk-header-row">
        <a class="mk-brand" href={withBase("/")} aria-label="Glimmer UI home">
          <Fragment set:html={logo} />
          <span>Glimmer UI</span>
        </a>
        <nav class="mk-nav" aria-label="Main">
          <a href={withBase("/docs/")}>Docs</a>
          <a href="#components">Components</a>
          <a class="mk-nav-wide" href={withBase("/docs/guides/performance/")}>Guides</a>
          <a class="mk-nav-wide" href="https://www.npmjs.com/org/glimmerui">npm</a>
        </nav>
        {stacks.map((st) => (
          <a class="mk-btn mk-btn--dark mk-header-cta" data-for={st.id} href={withBase(st.guide)}>Get started</a>
        ))}
      </div>
    </header>

    <main id="main" class="mk-page">
      <section class="mk-section mk-hero" aria-labelledby="hero-title">
        <div class="mk-wrap">
          <span class="mk-chrome" data-chrome data-glimmer="">
            <span class="mk-badge"><Fragment set:html={svg(icon.spark)} />WebGL components</span>
          </span>
          <h1 id="hero-title" class="mk-display">
            Thirty-seven shader effects for React, Vue, Nuxt and Svelte.{" "}
            <span class="mk-tone">Each one is a component you drop into a page.</span>
          </h1>
          <fieldset id="stack" class="mk-stack">
            <legend class="mk-stack-legend">
              <span class="mk-mono">Your stack</span>
              <span class="mk-stack-hint" data-stack-hint>Pick one and the code on this page follows it.</span>
            </legend>
            <div class="mk-stack-options">
              {
                stacks.map((st) => (
                  <label class="mk-stack-option" style={`--brand: ${st.color}`}>
                    <input type="radio" name="stack" value={st.id} />
                    <span class="mk-stack-logo" set:html={stackLogo(st.id)} />
                    <span>{st.name}</span>
                  </label>
                ))
              }
            </div>
          </fieldset>
          <div class="mk-actions">
            <span class="mk-chrome mk-chrome--button" data-chrome data-glimmer="">
              {stacks.map((st) => (
                <a class="mk-btn mk-btn--dark" data-for={st.id} href={withBase(st.guide)}>Get started with {st.name}</a>
              ))}
            </span>
            <a class="mk-btn" href={withBase("/docs/")}>Read the docs</a>
            <div class="mk-install">
              {stacks.map((st) => <code data-for={st.id}>{st.install}</code>)}
              <button type="button" class="mk-copy">Copy</button>
            </div>
          </div>
        </div>

        <div class="mk-wrap mk-wrap--flush">
          <div class="mk-band">
            <ShaderGradient
              client:load
              className="mk-band-effect"
              colors={["#121117", "#9ea0a8", "#f4f4f6"]}
              speed={0.7}
              data-glimmer=""
            />
            <div class="mk-window">
              <div class="mk-window-bar">
                <span class="mk-window-dots" aria-hidden="true"><i></i><i></i><i></i></span>
                {stacks.map((st) => <span class="mk-mono" data-for={st.id}>{st.file}</span>)}
                <span class="mk-live">Live</span>
              </div>
              <div class="mk-window-body">
                <div class="mk-window-stage">
                  <TiltCard
                    client:load
                    src={withBase("/demo.png")}
                    alt="Test pattern of a grid and rings, tilting toward the pointer"
                    style={{ width: "100%", aspectRatio: "4 / 3" }}
                    data-glimmer=""
                  />
                </div>
                <div class="mk-props">
                  {stacks.map((st) => <span class="mk-mono mk-props-title" data-for={st.id}>{st.inputs}</span>)}
                  <dl>
