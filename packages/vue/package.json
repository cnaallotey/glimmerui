{
  "name": "@glimmerui/vue",
  "version": "0.0.0",
  "description": "Glimmer UI WebGL components for Vue and Nuxt",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "keywords": [
    "vue",
    "vue-component",
    "webgl",
    "shader",
    "motion",
    "animation",
    "ui"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build && vue-tsc --declaration --emitDeclarationOnly --noEmit false --outDir dist",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@glimmerui/core": "workspace:*"
  },
  "peerDependencies": {
    "vue": ">=3.4"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.0",
    "vite": "^6.0.0",
    "vue": "^3.5.0",
    "vue-tsc": "^2.2.0"
  }
}
