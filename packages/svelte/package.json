{
  "name": "@glimmerui/svelte",
  "version": "0.2.0",
  "description": "Glimmer UI WebGL components for Svelte and SvelteKit",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cnaallotey/glimmerui.git",
    "directory": "packages/svelte"
  },
  "homepage": "https://github.com/cnaallotey/glimmerui#readme",
  "bugs": {
    "url": "https://github.com/cnaallotey/glimmerui/issues"
  },
  "type": "module",
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "keywords": [
    "svelte",
    "svelte-component",
    "sveltekit",
    "webgl",
    "shader",
    "motion",
    "animation",
    "ui"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "svelte-package --input src/lib --output dist",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings"
  },
  "dependencies": {
    "@glimmerui/core": "workspace:*"
  },
  "peerDependencies": {
    "svelte": ">=5"
  },
  "devDependencies": {
    "@sveltejs/package": "~2.5.8",
    "svelte": "^5.59.2",
    "svelte-check": "^4.7.8",
    "typescript": "^5.9.3"
  }
}
